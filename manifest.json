{
  "manifest_version": 3,
  "name": "Endpoint Mapper",
  "version": "2.0.0",
  "description": "Maps the API endpoints a site calls while you browse it, with the shape of each request and response, and exports OpenAPI.",
  "permissions": ["webRequest", "storage", "activeTab"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["hook.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true },
    { "matches": ["https://*/*"], "js": ["relay.js"], "run_at": "document_start", "all_frames": true }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Endpoint Mapper",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
